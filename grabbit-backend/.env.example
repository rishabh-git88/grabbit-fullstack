PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRE=7d

# Razorpay (get from razorpay.com dashboard). Use test mode for a deployed payment test.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Frontend URLs (for CORS)
VENDOR_DASHBOARD_URL=https://your-vendor-app.example.com
STUDENT_APP_URL=https://your-student-app.example.com
# Optional, comma-separated preview or additional origins
ADDITIONAL_ALLOWED_ORIGINS=

NODE_ENV=development

# Firebase Admin (required)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: one existing Firebase account to grant access to every cafe at startup.
# Use only for a trusted administrator/vendor and remove after the first successful deploy.
MULTI_CAFE_VENDOR_EMAIL=
