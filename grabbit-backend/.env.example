PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRE=7d

# Razorpay (get from razorpay.com dashboard). Use test mode for a deployed payment test.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Frontend URLs (for CORS)
VENDOR_DASHBOARD_URL=https://your-vendor-app.example.com
STUDENT_APP_URL=https://your-student-app.example.com
# Optional, comma-separated preview or additional origins
ADDITIONAL_ALLOWED_ORIGINS=

NODE_ENV=development

# Firebase Admin (required)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Vendor registration approval codes are sent only to this parent/admin email.
RESEND_API_KEY=
PARENT_APPROVAL_EMAIL=grabbit.vendor@gmail.com
# Set this after verifying a domain in Resend. Until then the Resend test sender
# is used, which can deliver only to the Resend account owner's email.
RESEND_FROM_EMAIL=Grabbit <onboarding@resend.dev>

# Vendor allowlist. Each key is a Google email and each array names only the
# cafes that account may manage. Every other Firebase user remains a student.
VENDOR_CAFE_ACCESS={"vendor@example.com":["Mayuri"]}
